# 虚拟环境
.venv/
venv/

# 模型权重（约 200MB，按需下载，不进版本库）
models/*.pt
models/*.part
models/*.onnx

# 处理结果与临时数据
output/
.session/
.cache/
.tmpdl/
# 修复输出图（保存时带 _inpaint 后缀）
samples/*_inpaint*

# 模型权重缓存（HF_HOME）。RORem 那套 SDXL 权重 6.5GB，
# 实测不通过后已删；留着这条规则防止以后再往这里下大文件被误提交。
.hf-cache/

# 日志
*.log
iopaint.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# 编辑器
.idea/
*.swp
.DS_Store
Thumbs.db

# ---------------------------------------------------------------
# 含真人肖像的示例图 —— 一律不进仓库
#
# 本仓库定位开源，samples/ 里只能放合成测试图（渐变、色块）。
# 实拍照片的对比图 / 示意截图请留在本地。
#
# ⚠ 这里踩过一次：原规则写的是 `对比_*.png`，但实际文件叫
#    `去伞_前后对比.jpg` —— 扩展名对不上（png vs jpg），
#    于是 3 张真人照片在 v0.01/v0.02 里躺了很久，一次都没被拦住。
#    改完规则必须用 `git check-ignore -v` 实测，别看着像对就完事。
# ---------------------------------------------------------------
samples/*对比*.jpg
samples/*对比*.png
samples/*示意*.jpg
samples/*示意*.png

# 分频带诊断产出的对比图（同样含真人裁切）
对比_*.png

# 实验探针产出的图（docs/*_probe/）—— 都是过程产物，
# 而且这些实验都是拿私人照片跑的，产出图等于照片的裁切/放大。
# 探针每次跑都会重新生成，不需要入库。
docs/*_probe/
